# SecureChat environment template. Copy with `scripts/gen-secrets.sh` (generates random values
# and JWT signing keys into ./secrets). Never commit .env or ./secrets.
COMPOSE_PROJECT_NAME=securechat

# Public ports (host). Only the edge nginx is published.
CHAT_HTTP_PORT=8100
ADMIN_HTTP_PORT=8101
# Dev-only tools bound to 127.0.0.1
KAFKA_UI_PORT=8190
GRAFANA_PORT=8130
PROMETHEUS_PORT=8191
PGADMIN_PORT=8192

# PostgreSQL: superuser (init only) and one login role per service-owned database
POSTGRES_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
USER_DB_PASSWORD=change-me
KEY_DB_PASSWORD=change-me
CONVERSATION_DB_PASSWORD=change-me
MONITORING_DB_PASSWORD=change-me
ADMIN_DB_PASSWORD=change-me

# Cassandra: superuser (init only) and one role per keyspace owner
CASSANDRA_ADMIN_PASSWORD=change-me
MESSAGE_CASSANDRA_PASSWORD=change-me
DELIVERY_CASSANDRA_PASSWORD=change-me

# Redis ACL users (one per service)
REDIS_ADMIN_PASSWORD=change-me
REDIS_PRESENCE_PASSWORD=change-me
REDIS_WSGATEWAY_PASSWORD=change-me
REDIS_FANOUT_PASSWORD=change-me
REDIS_DELIVERY_PASSWORD=change-me
REDIS_APIGW_PASSWORD=change-me

# Service-to-service credential for /internal/** endpoints (never routed publicly)
INTERNAL_SERVICE_TOKEN=change-me

# Admin portal bootstrap (first SUPER_ADMIN; must change password + enrol MFA on first login)
ADMIN_BOOTSTRAP_USERNAME=superadmin
ADMIN_BOOTSTRAP_PASSWORD=change-me
# AES-256 key (base64) encrypting admin TOTP secrets at rest
ADMIN_MFA_ENCRYPTION_KEY=change-me
# true in production; false allows dev logins without TOTP enrolment
ADMIN_MFA_REQUIRED=false

GRAFANA_ADMIN_PASSWORD=change-me

# Prometheus basic auth (hash written to secrets/prometheus-web.yml by scripts/gen-prometheus-auth.sh)
PROMETHEUS_USER=prometheus
PROMETHEUS_PASSWORD=change-me

# Allowed browser origins (CORS/WebSocket origin check)
CHAT_ORIGIN=http://localhost:8100
ADMIN_ORIGIN=http://localhost:8101

# Chat client features
# Welcome tour for new users (true/false). Applies after `docker compose up -d frontend` (no rebuild needed).
ONBOARDING_ENABLED=true

# JVM sizing per service container
JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k"

# pgAdmin web login (dev tool, `--profile tools`)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
