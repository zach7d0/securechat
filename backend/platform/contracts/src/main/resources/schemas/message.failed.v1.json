{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:securechat:message.failed.v1.json",
  "type": "object",
  "required": [
    "messageId",
    "recipientDeviceId",
    "reason",
    "at"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "recipientDeviceId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "conversationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "recipientUserId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "additionalProperties": true
}
