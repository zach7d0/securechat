{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:securechat:user.registered.v1.json",
  "type": "object",
  "required": [
    "userId",
    "username",
    "at"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "displayName": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
