{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:securechat:device.connected.v1.json",
  "type": "object",
  "required": [
    "userId",
    "deviceId",
    "gatewayId",
    "at"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "gatewayId": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
