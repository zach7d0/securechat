{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:securechat:notification.requested.v1.json",
  "type": "object",
  "required": [
    "recipientUserId",
    "recipientDeviceId",
    "messageId",
    "at"
  ],
  "properties": {
    "recipientUserId": {
      "type": "string",
      "format": "uuid"
    },
    "recipientDeviceId": {
      "type": "string",
      "format": "uuid"
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
