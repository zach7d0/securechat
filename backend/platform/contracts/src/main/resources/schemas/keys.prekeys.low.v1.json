    "userId",
    "deviceId",
    "remainingPrekeys",
    "remainingKeyPackages"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "remainingPrekeys": {
      "type": "integer"
    },
    "remainingKeyPackages": {
      "type": "integer"
    }
  },
  "additionalProperties": true
}
