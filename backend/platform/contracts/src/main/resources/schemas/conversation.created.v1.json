{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:securechat:conversation.created.v1.json",
  "type": "object",
  "required": [
    "conversationId",
    "type",
    "memberUserIds",
    "createdBy",
    "at"
  ],
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "DIRECT",
        "GROUP"
      ]
    },
    "memberUserIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "createdBy": {
      "type": "string",
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
