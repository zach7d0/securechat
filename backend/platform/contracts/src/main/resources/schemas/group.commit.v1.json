{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:securechat:group.commit.v1.json",
  "type": "object",
  "required": [
    "conversationId",
    "epoch",
    "senderDeviceId",
    "memberUserIds",
    "at"
  ],
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "epoch": {
      "type": "integer"
    },
    "senderDeviceId": {
      "type": "string",
      "format": "uuid"
    },
    "memberUserIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
