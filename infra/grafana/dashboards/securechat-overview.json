{
 "uid": "securechat-overview",
 "title": "SecureChat \u2014 Messaging pipeline",
 "schemaVersion": 39,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Services up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(up{job=\"securechat\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Online users",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "max(presence_online_users)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "WebSocket connections",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(websocket_connections_active)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Outbox pending",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(outbox_pending)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Oldest outbox event",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "max(outbox_oldest_pending_age_seconds)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Pending deliveries",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "max(delivery_pending_messages)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Request rate by service",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "5xx error rate by service",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p95 latency by service",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "{{application}}",
     "refId": "A"
    },
    {
     "expr": "max by (application) (http_server_requests_seconds_max)",
     "legendFormat": "max {{application}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Messages accepted / rejected",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    }
   },
   "targets": [
    {
     "expr": "sum by (protocol) (rate(message_accepted_total[1m]))",
     "legendFormat": "accepted {{protocol}}",
     "refId": "A"
    },
    {
     "expr": "sum by (code) (rate(message_rejected_total[1m]))",
     "legendFormat": "rejected {{code}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Outbox publish",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (store,result) (rate(outbox_publish_total[1m]))",
     "legendFormat": "{{store}} {{result}}",
     "refId": "A"
    },
    {
     "expr": "max(outbox_oldest_pending_age_seconds)",
     "legendFormat": "oldest pending (s)",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Kafka consumer lag",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "max by (application) (kafka_consumer_fetch_manager_records_lag_max)",
     "legendFormat": "{{application}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Fanout",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "rate(fanout_latency_seconds_sum[5m]) / rate(fanout_latency_seconds_count[5m])",
     "legendFormat": "avg latency (s)",
     "refId": "A"
    },
    {
     "expr": "rate(fanout_recipient_devices_sum[5m])",
     "legendFormat": "recipient devices/s",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Delivery",
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (result) (rate(delivery_route_total[1m]))",
     "legendFormat": "route {{result}}",
     "refId": "A"
    },
    {
     "expr": "sum by (result) (rate(delivery_acks_total[1m]))",
     "legendFormat": "acks {{result}}",
     "refId": "B"
    },
    {
     "expr": "max(delivery_pending_messages)",
     "legendFormat": "pending",
     "refId": "C"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Datastores",
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (application) (hikaricp_connections_active)",
     "legendFormat": "PG active conns {{application}}",
     "refId": "A"
    },
    {
     "expr": "max by (application) (rate(message_persist_seconds_sum[5m]) / rate(message_persist_seconds_count[5m]))",
     "legendFormat": "Cassandra write latency (s)",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Presence & devices",
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "max(presence_online_users)",
     "legendFormat": "online users",
     "refId": "A"
    },
    {
     "expr": "sum(websocket_connections_active)",
     "legendFormat": "active devices (sockets)",
     "refId": "B"
    },
    {
     "expr": "sum(rate(presence_transitions_total[5m]))",
     "legendFormat": "transitions/s",
     "refId": "C"
    }
   ]
  }
 ]
}